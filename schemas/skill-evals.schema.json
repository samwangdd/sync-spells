{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sync-spells.local/schemas/skill-evals.schema.json",
  "title": "Sync Spells skill eval suite",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "skill", "evaluation_protocol", "cases"],
  "properties": {
    "schema_version": { "const": 1 },
    "skill": { "type": "string", "minLength": 1 },
    "evaluation_protocol": { "type": "string", "minLength": 1 },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "prompt", "fixture", "assertions"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "prompt": { "type": "string", "minLength": 1 },
          "fixture": {},
          "assertions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "target", "operator", "value"],
              "properties": {
                "id": { "type": "string", "minLength": 1 },
                "target": { "type": "string", "minLength": 1 },
                "operator": { "enum": ["equals", "contains", "not_contains"] },
                "value": {}
              }
            }
          }
        }
      }
    }
  }
}
