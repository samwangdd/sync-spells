{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sync-spells.local/schemas/skill-eval-verification.schema.json",
  "title": "Sync Spells skill eval verification",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "skill_version", "skill_digest", "evals_digest", "baseline_ref", "run_id", "status", "passed", "total", "verified_at", "workspace"],
  "properties": {
    "schema_version": { "const": 1 },
    "skill_version": { "type": "string", "minLength": 1 },
    "skill_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "evals_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "baseline_ref": { "type": "string", "minLength": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "status": { "enum": ["passed", "failed"] },
    "passed": { "type": "integer", "minimum": 0 },
    "total": { "type": "integer", "minimum": 1 },
    "verified_at": { "type": "string", "format": "date-time" },
    "workspace": { "type": "string", "minLength": 1 }
  }
}
